{
    "DismissGainedItems": {
        "doc": "点掉晚出现的「获得物资」弹窗，避免 Award 子步骤之间卡在邮件/活动入口",
        "algorithm": "OcrDetect",
        "text": ["获得物资"],
        "roi": [440, 90, 400, 140],
        "action": "ClickSelf",
        "preDelay": 300,
        "postDelay": 800,
        "maxTimes": 8,
        "next": ["#self", "MainThemes#next"]
    },
    "AwardInterludeDismiss": {
        "doc": "Award 子任务之间：先关奖励弹窗和公告；已在主界面时再等一会儿，避免「获得物资」晚弹出",
        "algorithm": "JustReturn",
        "next": [
            "DismissGainedItems",
            "AwardInterludeDismiss@CloseAnnos#next",
            "AwardInterludeWaitAtHome",
            "AwardInterludeDismiss@QuickSwitch@ToHome#next",
            "AwardInterludeDismiss@ReturnButtons#next",
            "Stop"
        ]
    },
    "AwardInterludeWaitAtHome": {
        "baseTask": "Home",
        "action": "DoNothing",
        "template": "SwitchTheme@ToggleSettingsMenu.png",
        "postDelay": 2000,
        "maxTimes": 2,
        "next": ["DismissGainedItems", "AwardInterludeAtHome"]
    },
    "AwardInterludeAtHome": {
        "baseTask": "Home",
        "action": "Stop",
        "template": "SwitchTheme@ToggleSettingsMenu.png"
    },
    "StatusBegin": {
        "doc": "只读状态任务：先回主界面，不点击战斗/领取",
        "algorithm": "JustReturn",
        "next": [
            "StatusAtHome",
            "StatusBegin@QuickSwitch@ToHome#next",
            "StatusBegin@ReturnButtons#next",
            "StatusBegin@CloseAnnos#next",
            "DismissGainedItems"
        ]
    },
    "StatusAtHome": {
        "baseTask": "Home",
