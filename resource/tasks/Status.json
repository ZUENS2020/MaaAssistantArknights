            "AwardInterludeDismiss@CloseAnnos#next",
            "AwardInterludeWaitAtHome",
            "AwardInterludeDismiss@QuickSwitch@ToHome#next",
            "AwardInterludeDismiss@ReturnButtons#next",
            "Stop"
        ]
    },
    "AwardInterludeWaitAtHome": {
